global:
  scrape_interval: 5s
  scrape_timeout: 2s

rule_files:
  - /etc/prometheus/dubi.rules.yml

scrape_configs:
  - job_name: dubi-dev
    scheme: https
    static_configs:
      # Docker Desktop exposes the host loopback through this name.
      - targets: [host.docker.internal:7444]
        labels:
          cluster: dubi-dev
          region: local
          node_name: dev
    tls_config:
      # Development only. Production must use ca_file and verification.
      insecure_skip_verify: true
